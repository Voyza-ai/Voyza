# ─── Voyza Backend Environment ──────────────────────────────────
# Copy this file to `.env` and fill in real values.
# Never commit `.env`. Only `.env.example` is tracked in git.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to hit this backend
CORS_ORIGIN=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Flight Providers ───────────────────────────────────────────
# Duffel (https://duffel.com) — use test token in dev
DUFFEL_ACCESS_TOKEN=duffel_test_your_token_here

# Kiwi / Tequila (optional, add later)
# KIWI_API_KEY=

# ─── Hotels (RapidAPI / Booking.com) ───────────────────────────
RAPIDAPI_KEY=

# ─── Deutsche Bahn REST API ────────────────────────────────────
DB_REST_BASE_URL=https://v6.db.transport.rest

# ─── Frontend URL (for invite links, redirects) ────────────────
FRONTEND_URL=http://localhost:3000

# ─── Payments ───────────────────────────────────────────────────
# Stripe (optional, add later)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
